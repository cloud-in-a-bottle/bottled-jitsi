#!/bin/bash
# jitsi-videobridge2 -- the SFU that actually forwards RTP media
# between participants. Listens on JVB_PORT/udp (default 9500 here)
# for media and connects out to prosody over XMPP for control.
exec 2>&1

# Give prosody a head start just like jicofo does.
for _ in $(seq 1 30); do
    if (echo >/dev/tcp/127.0.0.1/5222) 2>/dev/null; then
        break
    fi
    sleep 1
done

# shellcheck disable=SC1091
[[ -f /etc/jitsi/videobridge/config ]] && . /etc/jitsi/videobridge/config

# Find the JVB launcher -- its install path has drifted across
# versions. Check the most likely locations.
for candidate in \
    /usr/share/jitsi-videobridge2/jvb.sh \
    /usr/share/jitsi-videobridge/jvb.sh \
    /opt/jitsi-videobridge/jvb.sh \
    /usr/bin/jitsi-videobridge; do
    if [[ -x "$candidate" ]]; then
        echo "[jvb] launching $candidate"
        exec "$candidate"
    fi
done
echo "[jvb] FATAL: could not find jvb launcher in any expected path" >&2
ls -la /usr/share/ | grep -i jitsi >&2
exit 127
