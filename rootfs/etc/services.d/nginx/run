#!/bin/bash
# Nginx serves the Jitsi Meet SPA + proxies BOSH / XMPP-WS / colibri-ws
# to prosody and JVB. Configured by the jitsi-meet-web-config Debian
# package to listen on :80 (and :443, but the cont-init rewriter
# strips :443 since OpenHost terminates TLS upstream).
exec 2>&1
echo "[nginx] sites-enabled: $(ls /etc/nginx/sites-enabled/ 2>&1)"
echo "[nginx] full dump of active :80 servers (nginx -T filtered):"
nginx -T 2>&1 | awk '
    /^server\s*\{/ { in=1; blk=""; want=0 }
    in { blk = blk ORS $0 }
    in && /server_name/ { sn=$0 }
    in && /listen.*80/ { want=1 }
    in && /^}/ { if (want) print sn; in=0 }
' | head -20 | sed 's/^/[nginx :80] /'
exec /usr/sbin/nginx -g "daemon off;"
