#!/bin/bash
# Nginx serves the Jitsi Meet SPA + proxies BOSH / XMPP-WS / colibri-ws
# to prosody and JVB. Configured by the jitsi-meet-web-config Debian
# package to listen on :80 (and :443, but the cont-init rewriter
# strips :443 since OpenHost terminates TLS upstream).
exec 2>&1
echo "[nginx] sites-enabled: $(ls /etc/nginx/sites-enabled/ 2>&1)"
echo "[nginx] conf.d: $(ls /etc/nginx/conf.d/ 2>&1)"
echo "[nginx] nginx -T (listen + server_name + root lines only):"
nginx -T 2>&1 | grep -E "^\s*(listen|server_name|root\s|include\s)" | head -40 | sed 's/^/[nginx -T] /'
echo "[nginx] ls /usr/share/jitsi-meet/:"
ls /usr/share/jitsi-meet/ 2>&1 | head -10 | sed 's/^/[jitsi-meet] /'
echo "[nginx] full dump of :80 server block in the active vhost:"
awk '
  /^server\s*\{/ { in_s=1; buf=""; has80=0 }
  in_s { buf = buf $0 ORS }
  in_s && /listen.*80\b/ && !/#/ { has80=1 }
  in_s && /^\}/ { if (has80) print buf; in_s=0 }
' /etc/nginx/sites-enabled/*.conf | head -50 | sed 's/^/[nginx :80] /'
exec /usr/sbin/nginx -g "daemon off;"
